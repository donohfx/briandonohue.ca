---
import BackToChat from '../components/BackToChat.astro';
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import { kindWords, site } from '../site';
import { about } from '../about';
import { inline } from '../lib/inline';

const linkedin = site.links.find((l) => l.label === 'LinkedIn')?.href;
const schema = {
  '@type': 'ProfilePage',
  '@id': new URL('/about/#page', Astro.site).href,
  url: new URL('/about/', Astro.site).href,
  name: `About ${site.name}`,
  mainEntity: { '@id': new URL('/#brian', Astro.site).href },
};
---

<Base title={about.title} description={about.description} md="/about.md" schema={[schema]}>
  <h1>About</h1>

  <div class="prose">
    <p class="lede">{about.lede}</p>
    {about.intro.map((p) => <p set:html={inline(p)} />)}

    <h2>How I work</h2>
    <ul>
      {about.howIWork.map((item) => <li set:html={inline(item)} />)}
    </ul>
  </div>

  <section class="path">
    <h2 class="label">Path</h2>
    <ol>
      {
        about.path.map((p) => (
          <li class={p.org ? 'org' : 'sub'}>
            <div class="head">
              <span class="role">
                {p.org && <strong>{p.org}</strong>}
                {p.org && p.role && <span class="sep"> · </span>}
                {p.role}
              </span>
              <span class="when">{p.when}</span>
            </div>
            <p class="note">{p.note}</p>
          </li>
        ))
      }
    </ol>
    <p class="more">{about.pathNote}</p>
    {linkedin && (
      <p class="more">
        <a href={linkedin}>LinkedIn</a>
      </p>
    )}
  </section>

  <section class="kind">
    <h2 class="label">Kind words</h2>
    <div class="quotes">
      {kindWords.filter((k) => !k.featured).map((k) => <Quote {...k} small />)}
    </div>
    <p class="more">
      From <a href="https://www.linkedin.com/in/brian-donohue-a61357114/details/recommendations/"
        >recommendations on LinkedIn</a
      >.
    </p>
  </section>

  <div class="prose">
    <h2>Off the clock</h2>
    {about.offTheClock.map((p) => <p set:html={inline(p)} />)}
  </div>
  <BackToChat />
</Base>

<style>
  h1 {
    margin-bottom: 2rem;
  }
  .path {
    margin: 3rem 0 1rem;
  }
  .path ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .path li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .path li.sub {
    position: relative;
    padding-left: 1.5rem;
  }
  .path li.sub::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 1.6rem;
    width: 0.6rem;
    height: 1px;
    background: var(--faint);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
  }
  .role {
    font-family: var(--serif);
    font-size: 1.1rem;
  }
  .role strong {
    font-weight: 600;
  }
  .sep {
    color: var(--faint);
  }
  .when {
    font-family: var(--meta-font);
    font-size: 0.8rem;
    color: var(--faint);
    white-space: nowrap;
  }
  .note {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.925rem;
    line-height: 1.5;
  }
  .kind {
    margin: 3rem 0 1rem;
  }
  .quotes {
    display: grid;
    gap: 1.75rem;
  }
  .more {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 1rem;
  }
</style>
