---
import '../styles/global.css';
import CardHead from '../components/CardHead.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Skip the content card (the homepage chat is its own card). */
  bare?: boolean;
  /** Path of this page's Markdown version, for AI agents. */
  md?: string;
  /** Extra schema.org nodes for this page (added to the site-wide graph). */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, bare = false, md, schema = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Technology professional in Halifax`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (p: string) => new URL(p, Astro.site).href;

// Who this site is about, in a form search engines and AI assistants read.
// sameAs ties this site to the same person's LinkedIn and GitHub.
const person = {
  '@type': 'Person',
  '@id': abs('/#brian'),
  name: site.name,
  url: abs('/'),
  image: abs('/brian.jpg'),
  description: site.description,
  jobTitle: site.person.jobTitle,
  worksFor: { '@type': 'Organization', name: site.person.employer.name, url: site.person.employer.url },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.person.locality,
    addressRegion: site.person.region,
    addressCountry: site.person.country,
  },
  knowsAbout: site.person.knowsAbout,
  ...(site.email ? { email: `mailto:${site.email}` } : {}),
  sameAs: site.links.map((l) => l.href),
};
const website = {
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: site.name,
  description: site.description,
  inLanguage: 'en-CA',
  author: { '@id': person['@id'] },
};
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': [person, website, ...schema] }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content={site.name} />
    {site.links.map((l) => <link rel="me" href={l.href} />)}
    {md && <link rel="alternate" type="text/markdown" href={md} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script type="application/ld+json" set:html={jsonld} />
    {site.verify.google && <meta name="google-site-verification" content={site.verify.google} />}
    {site.verify.bing && <meta name="msvalidate.01" content={site.verify.bing} />}
    {
      site.analytics.plausible && (
        <>
          <script async src={site.analytics.plausible} />
          <script is:inline>
            window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
            plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
            plausible.init();
          </script>
        </>
      )
    }
    <script is:inline>
      // Mark JS as available (the chat hides its no-JS transcript), then apply a
      // saved day/night override before first paint. No override = follow the system.
      document.documentElement.classList.add('js');
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
        // A burnt-out bulb (five quick clicks on the switch) lasts until a reload.
        try {
          const nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.type === 'reload') sessionStorage.removeItem('bulb');
          else if (sessionStorage.getItem('bulb') === 'out') document.documentElement.dataset.theme = 'candle';
        } catch {}
      })();
    </script>
    <meta name="theme-color" content="#e6ece8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1924" media="(prefers-color-scheme: dark)" />
  </head>
  <body class:list={{ fit: bare }}>
    <a class="skip" href="#main">Skip to content</a>
    <main class="wrap" id="main" tabindex="-1">
      {
        bare ? (
          <slot />
        ) : (
          <div class="card page-card card-shell">
            <CardHead />
            <div class="card-body">
              <slot />
            </div>
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main:focus {
    outline: none;
  }
  /* Home: header, chat and footer fit the window, so the page itself never
     scrolls; only the conversation does. Short windows (or zoomed in) fall back
     to normal page scrolling. */
  @media (min-height: 34rem) {
    body.fit {
      height: 100dvh;
    }
    .fit main {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-top: clamp(1rem, 3vw, 2rem);
      padding-bottom: 0.75rem;
    }
  }
  main {
    flex: 1;
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: 1.5rem;
  }
</style>
