---
// The Konami code (↑↑↓↓←→←→BA), or five taps on the footer coordinates,
// fires a 'konami' event: the page collapses into a pile, and once it's tidied
// up the check engine light comes on.
---

<div class="egg-toast" role="status" aria-live="polite" hidden>
  <span class="egg-msg"></span>
  <button class="egg-btn" type="button" hidden>Put it back</button>
</div>

<div class="cel" hidden>
  <button class="cel-light" type="button" aria-label="Check engine light. Open diagnostics" aria-expanded="false">
    <svg viewBox="0 0 32 22" width="26" height="18" aria-hidden="true">
      <path
        d="M4 8 H8 V5 H13 V3 H20 V5 H23 L26 8 H28 V6 H30 V16 H28 V14 H26 L23 18 H10 L8 15 H4 Z M1 9 V15"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="round"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="cel-panel" role="dialog" aria-label="Diagnostics" hidden>
    <p class="cel-title">Diagnostics</p>
    <dl>
      <dt>C0LLPS</dt><dd>Structural failure. Tidied up, mostly.</dd>
      <dt>P0420</dt><dd>Too many side projects</dd>
      <dt>P1976</dt><dd>Boat</dd>
      <dt>P0171</dt><dd>Banjo bolt replaced. Still leaking.</dd>
      <dt>U0VW1</dt><dd>German engineering detected</dd>
      <dt>B0042</dt><dd>Cat on keyboard</dd>
    </dl>
    <p class="cel-action">Recommended action: none, apparently.</p>
    <button class="cel-clear" type="button">Clear codes</button>
  </div>
</div>

<script>
  const toastEl = document.querySelector<HTMLElement>('.egg-toast')!;
  const msgEl = toastEl.querySelector<HTMLElement>('.egg-msg')!;
  const btn = toastEl.querySelector<HTMLButtonElement>('.egg-btn')!;
  let toastTimer: number | undefined;
  function toast(msg: string, ms = 2600) {
    msgEl.textContent = msg;
    btn.hidden = true;
    toastEl.hidden = false;
    clearTimeout(toastTimer);
    if (ms) toastTimer = window.setTimeout(() => (toastEl.hidden = true), ms);
  }

  // People who have found the egg get a little more of it on later visits.
  const FOUND = 'egg-found';
  const found = () => {
    try {
      return localStorage.getItem(FOUND) === '1';
    } catch {
      return false;
    }
  };
  const markFound = () => {
    try {
      localStorage.setItem(FOUND, '1');
    } catch {}
  };

  // ---------- Check engine light ----------
  const cel = document.querySelector<HTMLElement>('.cel')!;
  const light = cel.querySelector<HTMLButtonElement>('.cel-light')!;
  const panel = cel.querySelector<HTMLElement>('.cel-panel')!;
  const clear = cel.querySelector<HTMLButtonElement>('.cel-clear')!;
  document.querySelector('header nav')?.append(cel);

  // True when the light came back on by itself, rather than right after a collapse.
  let unprompted = false;
  function engineOn(byItself = false) {
    unprompted = byItself;
    cel.hidden = false;
    light.classList.add('on');
  }
  function closePanel() {
    panel.hidden = true;
    light.setAttribute('aria-expanded', 'false');
  }
  light.addEventListener('click', () => {
    panel.hidden = !panel.hidden;
    light.setAttribute('aria-expanded', String(!panel.hidden));
    toastEl.hidden = true;
  });
  clear.addEventListener('click', () => {
    closePanel();
    cel.hidden = true;
    toast('Codes cleared.');
    // If the light came on by itself, one time in five clearing it doesn't go well.
    // Never straight after a collapse, and only once the toast has had a moment.
    if (unprompted && Math.random() < 0.2) {
      window.setTimeout(() => window.dispatchEvent(new Event('konami')), 2200);
    }
  });

  // On later visits, the light sometimes comes back on by itself.
  let relight: number | undefined;
  if (found() && Math.random() < 0.25) {
    relight = window.setTimeout(() => engineOn(true), 3000 + Math.random() * 9000);
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      closePanel();
      light.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!panel.hidden && !cel.contains(e.target as Node)) closePanel();
  });

  // ---------- Collapse ----------
  let busy = false;
  window.addEventListener('konami', async () => {
    const main = document.querySelector<HTMLElement>('main');
    if (busy || !main) return;
    busy = true;
    markFound();
    clearTimeout(relight);
    // The arrow keys in the code scroll the page; let that settle, then collapse
    // whatever is on screen right where it is.
    await new Promise((r) => setTimeout(r, 350));
    const { collapse } = await import('../scripts/collapse');
    const pick = (sel: string) => [...document.querySelectorAll<HTMLElement>(sel)];
    const tidy = await collapse([main], {
      floor: pick('footer .neatline, footer .row > span:first-child, footer .konami, footer .coords'),
      late: pick('header .home, header nav > a, header nav > button'),
    });
    setTimeout(() => {
      toast('Working as intended.', 0);
      btn.hidden = false;
      btn.focus({ preventScroll: true });
    }, 1400);
    btn.onclick = async (e) => {
      // A click with a mouse or finger has a click count; Enter or Space doesn't.
      const fromKeyboard = e.detail === 0;
      toastEl.hidden = true;
      await tidy();
      busy = false;
      engineOn();
      // Keyboard users land on the light so they know it's there. Everyone else gets no
      // focus ring at all: the button they clicked is gone, so just let focus go.
      if (fromKeyboard) light.focus({ preventScroll: true });
      else (document.activeElement as HTMLElement | null)?.blur();
    };
  });
</script>

<style>
  .egg-toast {
    position: fixed;
    left: 50%;
    top: 5rem;
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }
  .egg-toast[hidden],
  .egg-btn[hidden] {
    display: none;
  }
  .egg-btn {
    appearance: none;
    font-style: normal;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--bg);
    border: 0;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    margin-right: -0.4rem;
    cursor: pointer;
  }
  .egg-btn:hover {
    opacity: 0.9;
  }
  .egg-btn:focus-visible {
    outline: 1.5px solid var(--bg);
    outline-offset: 2px;
  }

  /* Collapse */
  :global(html.collapsing) {
    overflow: hidden;
  }
  :global(.fall.falling) {
    display: inline-block;
    position: relative;
    z-index: 5;
    will-change: transform;
  }
  :global(img.falling) {
    position: relative;
    z-index: 4;
    will-change: transform;
  }
  :global(.chunk.falling) {
    display: inline-block;
    position: relative;
    z-index: 6;
    will-change: transform;
  }
  /* The footer is at the bottom of the pile but drawn over it, so you can see it holding everything up. */
  :global(.chunk.floor.falling) {
    z-index: 7;
  }
  :global(.neatline.chunk.falling) {
    display: block;
  }
  :global(.unframed),
  :global(.unframed *) {
    border-color: transparent !important;
    box-shadow: none !important;
  }
  :global(html.collapsing main *::before),
  :global(html.collapsing main *::after) {
    opacity: 0;
  }
  :global(html.collapsing main a) {
    text-decoration-color: transparent;
  }
  :global(html.collapsing main li::marker) {
    color: transparent;
  }

  /* Check engine light */
  .cel {
    position: relative;
    display: inline-flex;
    align-self: center;
  }
  .cel[hidden] {
    display: none;
  }
  .cel-light {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.25rem;
    line-height: 0;
    color: #e8a317;
    cursor: pointer;
    border-radius: 4px;
  }
  .cel-light.on svg {
    filter: drop-shadow(0 0 4px rgba(232, 163, 23, 0.8));
    animation: glow 1.4s ease-in-out infinite alternate;
  }
  @keyframes glow {
    from { opacity: 0.7; }
    to { opacity: 1; }
  }
  .cel-light:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cel-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    z-index: 25;
    width: 19.5rem;
    max-width: calc(100vw - 2rem);
    background: #0b0f0c;
    color: #e8a317;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.5;
    padding: 0.9rem 1rem 1rem;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .cel-panel[hidden] {
    display: none;
  }
  .cel-title {
    margin: 0 0 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
    opacity: 0.7;
  }
  .cel-panel dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.9rem;
    margin: 0;
  }
  .cel-panel dt {
    font-weight: 500;
  }
  .cel-panel dd {
    margin: 0;
    color: #f3d58e;
  }
  .cel-action {
    margin: 0.8rem 0;
    color: #f3d58e;
  }
  .cel-clear {
    appearance: none;
    font: inherit;
    color: #0b0f0c;
    background: #e8a317;
    border: 0;
    border-radius: 3px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }
  .cel-clear:focus-visible {
    outline: 2px solid #f3d58e;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cel-light.on svg {
      animation: none;
    }
  }
</style>
