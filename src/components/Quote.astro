---
interface Props {
  quote: string;
  name: string;
  role: string;
  small?: boolean;
  featured?: boolean;
}
const { quote, name, role, small = false } = Astro.props;
---

<figure class:list={['quote', { small }]}>
  <blockquote>{quote}</blockquote>
  <figcaption><span class="name">{name}</span><span class="role">{role}</span></figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
  }
  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  blockquote::before {
    content: '“';
  }
  blockquote::after {
    content: '”';
  }
  .small blockquote {
    font-size: 1.1rem;
    line-height: 1.5;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
  }
  .name {
    font-weight: 550;
  }
  .role {
    color: var(--muted);
  }
</style>
