---
// The strip at the top of every page's window: photo, name, status, menu.
// It keeps the same view-transition name everywhere, so it holds still while
// the window below it changes from page to page.
import { site, nav } from '../site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** On the chat itself: the status line changes to "typing…" while Brian replies. */
  live?: boolean;
}
const { live = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="card-head">
  <a class="id" href="/" aria-label={`${site.name}, back to the chat`}>
    <span class="avatar">
      <img src="/brian.jpg" alt="" width="44" height="44" />
      <span class="online" aria-hidden="true"></span>
    </span>
    <span class="names" aria-hidden="true">
      <span class="who">{site.name}</span>
      <span class="sub" data-sub={live ? '' : undefined}>Usually replies within a day</span>
    </span>
  </a>
  <nav aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</div>

<style is:global>
  .card-head {
    view-transition-name: card-head;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    background: var(--card);
    border-radius: 22px 22px 0 0;
  }
  .card-head .id {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  .card-head .avatar {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
  }
  .card-head .avatar img {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .card-head .online {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #2e9e4f;
    border: 2px solid var(--card);
  }
  .card-head .names {
    display: flex;
    flex-direction: column;
  }
  .card-head .who {
    font-weight: 600;
    line-height: 1.3;
  }
  .card-head .sub {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .card-head nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.925rem;
  }
  .card-head nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .card-head nav a:hover {
    color: var(--ink);
  }
  .card-head nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--chat-accent);
    text-underline-offset: 0.35em;
  }
  /* Reading pages: the strip stays at the top while the page scrolls under it. */
  .page-card > .card-head {
    position: sticky;
    top: 0;
    z-index: 3;
  }
  @media (max-width: 40rem) {
    .card-head { padding: 0.85rem 1rem; }
    .card-head nav { gap: 1rem; padding-left: calc(44px + 0.75rem); }
  }
</style>
