---
// Day/night switch. Follows the system until clicked. Clicking back to whatever
// the system prefers clears the override, so it returns to "auto".
---

<button class="toggle" type="button" aria-label="Switch to night mode">
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const btn = document.querySelector<HTMLButtonElement>('.toggle');

  const system = () => (media.matches ? 'dark' : 'light');
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? system();

  function sync() {
    if (!btn) return;
    const isDark = current() === 'dark';
    const auto = !root.dataset.theme;
    btn.dataset.mode = isDark ? 'dark' : 'light';
    const label = isDark ? 'Switch to day mode' : 'Switch to night mode';
    btn.setAttribute('aria-label', label);
    btn.title = auto ? `${label} (currently following your system)` : label;
  }

  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    if (next === system()) {
      delete root.dataset.theme;
      try { localStorage.removeItem('theme'); } catch {}
    } else {
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    }
    sync();
  });

  media.addEventListener('change', sync);
  sync();
</script>

<style>
  .toggle {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.25rem;
    margin: -0.25rem -0.25rem -0.25rem 0;
    color: var(--muted);
    cursor: pointer;
    line-height: 0;
    border-radius: 4px;
    align-self: center;
  }
  .toggle:hover {
    color: var(--ink);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun,
  .toggle[data-mode='dark'] .moon {
    display: none;
  }
  .toggle[data-mode='dark'] .sun {
    display: block;
  }
</style>
