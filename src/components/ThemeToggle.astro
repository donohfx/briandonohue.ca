---
// Day/night switch. Follows the system until clicked. Clicking back to whatever
// the system prefers clears the override, so it returns to "auto".
// Click it five times in quick succession and the bulb burns out: the page
// flickers, flashes, goes dark and comes back by candlelight. The switch stays
// broken (across pages too) until the page is reloaded.
---

<button class="toggle" type="button" aria-label="Switch to night mode">
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
  <svg class="burnt" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9.5 18h5M10.5 21h3M12 3a6 6 0 0 0-3.9 10.6c.6.6.9 1.4.9 2.4h6c0-1 .3-1.8.9-2.4A6 6 0 0 0 12 3Z" />
    <path d="M10 9.5l1.2 1.6M14 9.5l-1.2 1.6" />
  </svg>
</button>
<span class="sr-only" role="status" data-bulb-status></span>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const btn = document.querySelector<HTMLButtonElement>('.toggle');
  const status = document.querySelector<HTMLElement>('[data-bulb-status]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const system = () => (media.matches ? 'dark' : 'light');
  const burnt = () => root.dataset.theme === 'candle';
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? system();

  function sync() {
    if (!btn) return;
    if (burnt()) {
      btn.dataset.mode = 'burnt';
      btn.setAttribute('aria-disabled', 'true');
      btn.setAttribute('aria-label', 'Light switch. The bulb burnt out. Reload the page to replace it.');
      btn.title = 'The bulb burnt out. Reload to replace it.';
      return;
    }
    const isDark = current() === 'dark';
    const auto = !root.dataset.theme;
    btn.dataset.mode = isDark ? 'dark' : 'light';
    const label = isDark ? 'Switch to day mode' : 'Switch to night mode';
    btn.setAttribute('aria-label', label);
    btn.title = auto ? `${label} (currently following your system)` : label;
  }

  function setThemeColor(color: string) {
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => (m.content = color));
  }

  async function burnOut() {
    try { sessionStorage.setItem('bulb', 'out'); } catch {}
    if (status) status.textContent = 'The light bulb burnt out. Candlelight until you reload the page.';
    const light = () => {
      root.dataset.theme = 'candle';
      setThemeColor('#140d08');
      sync();
    };
    if (reduce) {
      light();
    } else {
      const fx = document.createElement('div');
      fx.className = 'bulb-fx';
      fx.setAttribute('aria-hidden', 'true');
      document.body.append(fx);
      root.classList.add('bulb-flicker');
      await wait(1100);
      root.classList.remove('bulb-flicker');
      fx.classList.add('flash');
      await wait(160);
      fx.classList.add('dark');
      light();
      await wait(900);
      fx.classList.add('out');
      await wait(1600);
      fx.remove();
    }
    window.dispatchEvent(new Event('bulbout'));
  }

  let clicks: number[] = [];
  btn?.addEventListener('click', () => {
    if (burnt()) {
      btn.classList.remove('jiggle');
      void btn.offsetWidth;
      btn.classList.add('jiggle');
      return;
    }
    const now = performance.now();
    clicks = [...clicks.filter((t) => now - t < 4000), now];
    if (clicks.length >= 5) {
      clicks = [];
      burnOut();
      return;
    }
    const next = current() === 'dark' ? 'light' : 'dark';
    if (next === system()) {
      delete root.dataset.theme;
      try { localStorage.removeItem('theme'); } catch {}
    } else {
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    }
    sync();
  });

  if (burnt()) setThemeColor('#140d08');
  media.addEventListener('change', sync);
  sync();
</script>

<style>
  .toggle {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.25rem;
    margin: -0.25rem -0.25rem -0.25rem 0;
    color: var(--muted);
    cursor: pointer;
    line-height: 0;
    border-radius: 4px;
    align-self: center;
  }
  .toggle:hover {
    color: var(--ink);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .toggle[data-mode='burnt'] {
    cursor: default;
    color: var(--faint);
  }
  svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun,
  .burnt,
  .toggle[data-mode='dark'] .moon,
  .toggle[data-mode='burnt'] .moon {
    display: none;
  }
  .toggle[data-mode='dark'] .sun,
  .toggle[data-mode='burnt'] .burnt {
    display: block;
  }
  .toggle.jiggle {
    animation: jiggle 0.4s ease;
  }
  @keyframes jiggle {
    20% { transform: rotate(-14deg); }
    45% { transform: rotate(10deg); }
    70% { transform: rotate(-6deg); }
    100% { transform: none; }
  }
</style>

<style is:global>
  /* The bulb going: uneven flicker, a bright pop, darkness, then candlelight. */
  html.bulb-flicker body {
    animation: bulb-flicker 1.1s steps(1, end) both;
  }
  @keyframes bulb-flicker {
    0% { filter: brightness(1); }
    8% { filter: brightness(0.35); }
    12% { filter: brightness(1.15); }
    22% { filter: brightness(0.5); }
    26% { filter: brightness(1); }
    40% { filter: brightness(0.25); }
    46% { filter: brightness(1.2); }
    58% { filter: brightness(0.6); }
    64% { filter: brightness(1); }
    78% { filter: brightness(0.3); }
    84% { filter: brightness(1.35); }
    92% { filter: brightness(0.2); }
    100% { filter: brightness(1.5); }
  }
  .bulb-fx {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    background: #fff8e8;
    opacity: 0;
  }
  .bulb-fx.flash {
    opacity: 1;
  }
  .bulb-fx.dark {
    background: #000;
  }
  .bulb-fx.out {
    opacity: 0;
    transition: opacity 1.6s ease-in;
  }
</style>
